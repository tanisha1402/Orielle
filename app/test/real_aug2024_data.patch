+}
+
+class _District {
+  const _District(
+    this.id,
+    this.name,
+    this.rank,
+    this.lat,
+    this.lng, {
+    this.houses,
+    this.roadsKm,
+    this.schools,
+    this.croplandHa,
+    required this.summary,
+    required this.evidence,
+  });
+
+  final String id;
